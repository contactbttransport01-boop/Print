<section class="section wrap faq" id="Questions"><div><p class="eyebrow">ON VOUS RÉPOND</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2>{% if settings.contact_email != blank %}<a class="text-link" href="mailto:{{ settings.contact_email | escape }}">Nous contacter <span class="arrow" aria-hidden="true"></span></a>{% endif %}</div><div class="questions">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}</div></section>
{% schema %}
{"name":"Questions fréquentes","settings":[{"type":"textarea","id":"heading","label":"Titre","default":"Avant de\nchanger de style."}],"max_blocks":10,"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Votre question"},{"type":"richtext","id":"answer","label":"Réponse","default":"<p>Votre réponse.</p>"}]}],"presets":[{"name":"Questions fréquentes","blocks":[{"type":"question","settings":{"question":"Comment choisir le bon bracelet ?","answer":"<p>Vérifiez le modèle exact de votre montre, sa largeur d’entrecorne et son système de fixation. Une même largeur ne garantit pas à elle seule la compatibilité.</p>"}},{"type":"question","settings":{"question":"Comment choisir mon coloris ?","answer":"<p>Choisissez une variante dans le menu de la fiche produit. Le prix et la disponibilité s’actualisent selon votre choix. Les photos restent indicatives et les couleurs peuvent varier selon l’écran.</p>"}},{"type":"question","settings":{"question":"Où consulter les conditions de livraison et de retour ?","answer":"<p>Les conditions de la boutique sont accessibles dans les liens du pied de page lorsqu’elles sont renseignées.</p>"}}]}]}
{% endschema %}
