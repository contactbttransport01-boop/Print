<footer class="footer wrap">
  <div class="footer-top"><a class="logo" href="{{ routes.root_url }}">{{ settings.brand_name | default: shop.name | escape }}</a><p>{{ section.settings.tagline | escape }}</p><a href="{{ routes.all_products_collection_url }}">La collection ↗</a>{% if settings.contact_email != blank %}<a href="mailto:{{ settings.contact_email | escape }}">Nous contacter ↗</a>{% endif %}</div>
  <div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><nav aria-label="Informations légales">{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav><span>{{ powered_by_link }}</span></div>
  {% if section.settings.independent_note != blank %}<p class="footer-note">{{ section.settings.independent_note | escape }}</p>{% endif %}
</footer>
{% schema %}
{"name":"Pied de page","settings":[{"type":"text","id":"tagline","label":"Signature","default":"Un détail qui change le rythme."},{"type":"text","id":"independent_note","label":"Information complémentaire","default":"Boutique indépendante, sans affiliation avec les fabricants de montres mentionnés."}]}
{% endschema %}
