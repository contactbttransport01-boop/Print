<section class="section wrap"><h1 class="page-title">Votre recherche.</h1><form class="search-form" action="{{ routes.search_url }}" method="get" role="search"><label for="SearchTerms">Rechercher un produit</label><div><input id="SearchTerms" type="search" name="q" value="{{ search.terms | escape }}"><input type="hidden" name="type" value="product"><button class="button dark" type="submit">Rechercher</button></div></form>{% if search.performed %}{% paginate search.results by 12 %}<p>{{ search.results_count }} résultat{% if search.results_count != 1 %}s{% endif %}</p><div class="collection-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', card_product: item %}{% else %}<a href="{{ item.url }}">{{ item.title | escape }}</a>{% endif %}{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}{% endif %}</section>
{% schema %}{"name":"Recherche","settings":[]}{% endschema %}
