<section class="section wrap"><p class="eyebrow">LA SÉLECTION PRINT</p><h1 class="page-title">{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="rte collection-description">{{ collection.description }}</div>{% endif %}{% paginate collection.products by 12 %}<div class="collection-grid">{% for card_product in collection.products %}{% render 'product-card', card_product: card_product %}{% else %}<p>Cette collection ne contient pas encore de produit.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</section>
{% schema %}{"name":"Collection","settings":[]}{% endschema %}
