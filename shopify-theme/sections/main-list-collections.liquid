<section class="section wrap"><h1 class="page-title">Les collections.</h1><div class="collection-grid">{% for collection in collections %}<article class="product-card"><a class="card-image" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(max-width: 700px) 50vw, 33vw', alt: collection.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</a><h2><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h2></article>{% else %}<p>Les collections arrivent bientôt.</p>{% endfor %}</div></section>
{% schema %}{"name":"Liste des collections","settings":[]}{% endschema %}
