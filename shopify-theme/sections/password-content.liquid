<section class="section wrap prose"><a class="logo" href="{{ routes.root_url }}">{{ shop.name | escape }}</a><h1 class="page-title">La boutique se prépare.</h1>{% if shop.password_message != blank %}<div class="rte">{{ shop.password_message }}</div>{% endif %}{% form 'storefront_password' %}{{ form.errors | default_errors }}<label class="field-label" for="StorePassword">Mot de passe de la boutique</label><input id="StorePassword" type="password" name="password" autocomplete="current-password" required><button class="button dark" type="submit">Entrer dans la boutique</button>{% endform %}</section>
{% schema %}{"name":"Accès boutique","settings":[]}{% endschema %}
