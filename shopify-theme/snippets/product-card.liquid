<article class="product-card"><a class="card-image" href="{{ card_product.url }}">{% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 800 | image_tag: widths: '300, 500, 800', sizes: '(max-width: 700px) 50vw, 33vw', loading: 'lazy', alt: card_product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}{% unless card_product.available %}<span class="card-badge">Épuisé</span>{% endunless %}</a><h2><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h2><p>{% if card_product.price_varies %}À partir de {% endif %}{{ card_product.price | money }}</p></article>
