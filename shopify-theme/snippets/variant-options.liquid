        {% for variant in product.variants %}
          <option value="{{ variant.id }}"{% if variant == chosen_variant %} selected{% endif %} data-available="{{ variant.available }}" data-unit-cents="{{ variant.price }}" data-price="{{ variant.price | money | strip_html | escape }}" data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | strip_html | escape }}{% endif %}" data-min="{{ variant.quantity_rule.min | default: 1 }}" data-step="{{ variant.quantity_rule.increment | default: 1 }}" data-max="{{ variant.quantity_rule.max }}"{% if variant.featured_image %} data-image="{{ variant.featured_image | image_url: width: 1200 }}" data-image-alt="{{ variant.featured_image.alt | default: product.title | escape }}"{% endif %}>{{ variant.title | escape }} — {{ variant.price | money | strip_html }}{% unless variant.available %} · Épuisé{% endunless %}</option>
        {% endfor %}
